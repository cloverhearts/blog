        }
      ],
      "tests": [
        {
          "path": "tests/contracts/implementation-stack.test.ts",
          "cases": [
            "pins Node 24 LTS and bundled npm for every environment",
            "uses npm workspaces with one committed lockfile",
            "locks every approved implementation dependency",
            "exposes the documented root command surface",
            "runs contract and policy suites with Vitest",
            "declares every architecture lane as an npm workspace package",
            "records the approved production and classless UX baseline"
          ]
        },
        {
          "path": "tests/contracts/dependency-security.test.ts",
          "cases": [
            "locks patched versions of all security-reviewed dependencies including nested copies",
            "accepts fixed release boundaries and later stable patch releases",
            "rejects every previously vulnerable version even in a nested dependency",
            "rejects missing dependencies and unreviewed prerelease versions"
          ]
        }
      ]
