      "tests": [
        {
          "path": "tests/contracts/post-summary.test.ts",
          "cases": [
            "accepts a localized description of exactly 150 Unicode characters",
            "rejects a description of 151 Unicode characters",
            "trims surrounding whitespace before measuring a description",
            "rejects empty, Markdown, URL, placeholder, and title-copy descriptions",
            "compatibility excerpt skips a leading image and falls back to description",
            "rejects missing alt, remote, and non-raster thumbnail sources",
            "collections, RSS, and metadata use description while thumbnails stay off Open Graph"
          ]
        },
        {
          "path": "tests/contracts/pagination-navigation.test.ts",
          "cases": [
            "paginates home and collections by ten logical post groups"
          ]
        },
        {
          "path": "tests/contracts/curated-discovery.test.ts",
          "cases": [
            "rejects include and exclude of the same translation key"
          ]
        }
