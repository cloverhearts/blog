          "sha256": "175cd5992f89295ee14502724467904de67834d024b5c3922b939b01faf29aa2"
        }
      ],
      "tests": [
        {
          "path": "tests/contracts/i18n.test.ts",
          "cases": [
            "resolves locale-prefixed routes while Korean remains unprefixed",
            "resolves post navigation in the active language before fallbacks",
            "falls back to English, then Korean, and otherwise omits the post link",
            "publishes reviewed translation variants independently",
            "rejects publication before the authored original or owner review",
            "provides the same non-empty UI message set for every language",
            "identifies translated variants and links them to the original",
            "rejects translation metadata when the declared original is absent",
            "renders an optional original reference from validated metadata",
            "omits the optional original reference from the source-language post"
          ]
        },
        {
          "path": "tests/contracts/site-baseline.test.ts",
          "cases": [
            "pins production origin, Korean defaults, manual language selection, and fallback order",
            "keeps Japanese supported outside the primary design review pair",
            "uses unprefixed Korean and explicit English and Japanese route trees"
          ]
        }
      ]
