        }
      ],
      "tests": [
        {
          "path": "tests/contracts/site-baseline.test.ts",
          "cases": [
            "defines primary exploration as localized static links",
            "defines conservative GitHub Pages Pro budgets",
            "rejects budgets that consume a Pages service ceiling",
            "ships named component CSS with resilient Pretendard fallbacks",
            "keeps blog element defaults out of injected browser UI",
            "keeps the Pretendard dynamic subset within the font budget",
            "defines a static recovery path for every primary UX flow"
          ]
        },
        {
          "path": "tests/contracts/pagination-navigation.test.ts",
          "cases": [
            "omits footer navigation while keeping localized archive routes",
            "renders list and featured posts as one full-card link without inline presentation styles"
          ]
        },
        {
          "path": "tests/contracts/curated-discovery.test.ts",
          "cases": [
            "derives curated membership, work chronology, and configuration-only extra collections"
          ]
        },
        {
          "path": "tests/contracts/search.test.ts",
          "cases": [
            "does not search until the reader enters a query",
            "resolves only the active-language Pagefind index",
            "renders keyboard-reachable local result links without a server request",
            "indexes published language-isolated HTML and keeps C++ tokens searchable",
            "production search eligibility excludes drafts"
          ]
        },
        {
          "path": "tests/contracts/embed-core.test.ts",
          "cases": [
            "refuses remote, duplicate, and unregistered embed plugins",
            "executes a synthetic test-only embed plugin"
          ]
        },
        {
          "path": "tests/contracts/content-compiler.test.ts",
          "cases": [
            "compiles a Korean/English/Japanese C++ group into deterministic production artifacts",
            "rejects an unpublished authored original before a reviewed translation",
            "omits an unpublished translation sibling from production"
          ]
        },
        {
          "path": "tests/contracts/pipeline.test.ts",
          "cases": [
            "builds an empty production site with required Pages files"
          ]
        }
      ]
    },
