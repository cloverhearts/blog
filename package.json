{
  "name": "cloverhearts-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/embeds/*"
  ],
  "scripts": {
    "test": "npm run test:contracts",
    "test:contracts": "vitest run tests/contracts",
    "test:policy": "vitest run tests/contracts/policy-governance.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.13",
    "axe-core": "^4.13.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
