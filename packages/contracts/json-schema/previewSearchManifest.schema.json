{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provenance": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "buildMode": {
          "type": "string",
          "const": "preview"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentRulesHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "localizationRulesHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "buildMode",
        "producer",
        "producerVersion",
        "inputHash",
        "configHash",
        "contentRulesHash",
        "localizationRulesHash"
      ],
      "additionalProperties": false
    },
    "webInputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "indexedPostIdsByLanguage": {
      "type": "object",
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ko": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ja": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "en",
        "ko",
        "ja"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "provenance",
    "webInputHash",
    "indexedPostIdsByLanguage",
    "files"
  ],
  "additionalProperties": false
}
