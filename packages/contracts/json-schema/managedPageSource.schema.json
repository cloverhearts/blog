{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "document",
        "presentation",
        "application"
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "typescript"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "path"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "const": "en"
        },
        {
          "type": "string",
          "const": "ko"
        },
        {
          "type": "string",
          "const": "ja"
        }
      ]
    },
    "translationKey": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "returnTo": {
      "type": "string",
      "minLength": 1
    },
    "robots": {
      "type": "string",
      "enum": [
        "index",
        "noindex"
      ]
    },
    "sitemap": {
      "type": "boolean"
    },
    "security": {
      "type": "object",
      "properties": {
        "externalOrigins": {
          "type": "object",
          "properties": {
            "frame": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "script": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "connect": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "image": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "font": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "media": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "frame",
            "script",
            "connect",
            "image",
            "style",
            "font",
            "media"
          ],
          "additionalProperties": false
        },
        "iframePermissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "externalOrigins",
        "iframePermissions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "route",
    "kind",
    "entry",
    "status",
    "language",
    "title",
    "description",
    "returnTo",
    "robots",
    "sitemap",
    "security"
  ],
  "additionalProperties": false
}
